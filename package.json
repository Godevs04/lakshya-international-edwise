{
  "name": "lakshya-international-edwise",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-4000}",
    "build": "rm -rf .next && next build",
    "start": "next start -p ${PORT:-4000}",
    "start:standalone": "cp -R public .next/standalone/public && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/static && PORT=${PORT:-4000} HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:files": "knip --include files --no-progress",
    "check:env": "tsx scripts/check-env.ts",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:ci:prod": "echo 'Tip: run against next start (production), not next dev' && lhci autorun",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright install chromium && playwright test --ui",
    "seed": "tsx scripts/seed.ts",
    "sync:branding": "tsx scripts/seed.ts",
    "backup:mongodb": "bash scripts/backup-mongodb.sh",
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@scalar/nextjs-api-reference": "^0.11.4",
    "@sentry/nextjs": "^10.59.0",
    "@sentry/node": "^10.59.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "mongoose": "^9.7.1",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-cloudinary": "^6.17.5",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "posthog-js": "^1.399.2",
    "posthog-node": "^5.21.2",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.52.0",
    "@posthog/nextjs-config": "^1.7.6",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
